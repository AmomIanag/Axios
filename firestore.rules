rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validGoal() {
      return request.resource.data.keys().hasOnly([
          'name',
          'currentAmount',
          'targetAmount',
          'deadlineMonths',
          'monthlyContribution',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'currentAmount',
          'targetAmount',
          'deadlineMonths',
          'monthlyContribution',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.currentAmount is number
        && request.resource.data.currentAmount >= 0
        && request.resource.data.targetAmount is number
        && request.resource.data.targetAmount > 0
        && request.resource.data.currentAmount <= request.resource.data.targetAmount
        && request.resource.data.deadlineMonths is int
        && request.resource.data.deadlineMonths > 0
        && request.resource.data.deadlineMonths <= 1200
        && request.resource.data.monthlyContribution is number
        && request.resource.data.monthlyContribution >= 0
        && request.resource.data.createdAt is timestamp;
    }

    function validTransaction(userId) {
      return request.resource.data.keys().hasOnly([
          'ownerUid',
          'description',
          'category',
          'date',
          'amountInCents',
          'type',
          'origin',
          'externalId',
          'importBatchId',
          'fingerprint',
          'pending',
          'excludedFromBudget',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid',
          'description',
          'category',
          'date',
          'amountInCents',
          'type',
          'origin',
          'pending',
          'excludedFromBudget',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.ownerUid == userId
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.date is timestamp
        && request.resource.data.amountInCents is int
        && request.resource.data.amountInCents > 0
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.origin in ['manual', 'pdf', 'pluggy']
        && request.resource.data.pending is bool
        && request.resource.data.excludedFromBudget is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /goals/{goalId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validGoal();
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validTransaction(userId);
        allow update: if isOwner(userId)
          && resource.data.ownerUid == userId
          && validTransaction(userId);
        allow delete: if isOwner(userId) && resource.data.ownerUid == userId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
